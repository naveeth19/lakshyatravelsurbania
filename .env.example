# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Google Ads conversion id, e.g. AW-123456789
NEXT_PUBLIC_GADS_ID=

# Conversion labels from Google Ads, the part after the slash in the snippet
NEXT_PUBLIC_GADS_CALL_LABEL=
NEXT_PUBLIC_GADS_WA_LABEL=

# Lead notification email (Resend). Without these the form still accepts
# submissions and falls back to WhatsApp, but no email is sent.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Must be a domain verified in Resend. Defaults to the Resend sandbox sender.
ENQUIRY_FROM_EMAIL=

# Conversion label for form submissions (fires on /thank-you)
NEXT_PUBLIC_GADS_FORM_LABEL=
